# --------------------
# Environment / Secrets
# --------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local

# Keep example environment file
!.env.example

# --------------------
# Node / Next.js
# --------------------
node_modules/
.next/
out/
dist/
build/
coverage/

# Package manager caches
.npm/
.pnpm-store/
.yarn/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# --------------------
# Python / ML
# --------------------
__pycache__/
*.py[cod]
*$py.class
*.so

venv/
.venv/
env/
ENV/

.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python build artifacts
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# --------------------
# ML generated files
# --------------------
*.pkl
*.pickle
*.joblib

