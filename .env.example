# --- Geographic services (free / open-source, self-hostable) ---

# Geocoding + reverse geocoding (Nominatim). Public instance is for development
# only; point this at your own Nominatim for production.
GEOCODING_URL=https://nominatim.openstreetmap.org

# Identifying User-Agent required by the Nominatim usage policy.
GEO_USER_AGENT=RouteCast/1.0 (capstone digital twin)

# Routing engine (OSRM). Swap for a self-hosted OSRM/GraphHopper/Valhalla.
ROUTING_URL=https://router.project-osrm.org

# --- ML models (optional; heuristic fallback is used when absent) ---
ETA_MODEL_PATH=models/eta.onnx
CONGESTION_MODEL_PATH=models/congestion.onnx
